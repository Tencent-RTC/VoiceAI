<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vak_background">

    <!-- 会话列表（标题栏由宿主提供，本组件不含标题栏） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vak_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/vak_input_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部输入栏（封装组件：文字输入 / 按住说话） -->
    <com.tencent.voiceai.kit.view.component.AIChatInputBar
        android:id="@+id/vak_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/vak_white"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 顶部 Toast 提示 -->
    <TextView
        android:id="@+id/vak_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#E6323232"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:textColor="@color/vak_white"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
