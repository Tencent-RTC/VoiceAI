<?xml version="1.0" encoding="utf-8"?>
<!--
  AIChatActivity 专用布局：顶部标题栏（返回 / 标题 / 自动朗读开关）+ AIChatFragment 容器。
  AIChatFragment 本身不含标题栏，故由本 Activity 提供。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vak_background">

    <!-- 顶部标题栏 -->
    <RelativeLayout
        android:id="@+id/vak_title_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/vak_background"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/vak_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/vak_ic_back"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="AI 对话"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/vak_text_primary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/vak_btn_speaker"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/vak_bg_circle_active"
            android:padding="9dp"
            app:srcCompat="@drawable/vak_ic_volume_up"
            android:contentDescription="自动朗读" />
    </RelativeLayout>

    <!-- 对话主体容器 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/vak_fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/vak_title_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
