<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 对话底部输入栏（AIChatInputBar）的内部布局。
  以 <merge> 形式 inflate 进 AIChatInputBar（纵向 LinearLayout）。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <!-- 语音波形面板（语音识别中展示） -->
    <com.tencent.voiceai.kit.view.component.VoiceWaveView
        android:id="@+id/vak_wave"
        android:layout_width="match_parent"
        android:layout_height="118dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <!-- 键盘 / 语音切换（浅色圆底 + 蓝色图标） -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/vak_btn_toggle_mode"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/vak_bg_circle_light"
            android:padding="6dp"
            app:srcCompat="@drawable/vak_ic_mic_blue"
            android:contentDescription="切换语音输入" />

        <!-- 文本输入框 -->
        <EditText
            android:id="@+id/vak_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:minHeight="42dp"
            android:maxHeight="124dp"
            android:background="@drawable/vak_bg_input_field"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical"
            android:hint="说点什么…"
            android:textColorHint="@color/vak_text_secondary"
            android:textColor="@color/vak_text_primary"
            android:textSize="15sp"
            android:maxLines="5"
            android:inputType="textMultiLine"
            android:importantForAutofill="no" />

        <!-- 「按住说话」按钮（语音模式，默认隐藏） -->
        <TextView
            android:id="@+id/vak_hold_to_talk"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/vak_bg_input_field"
            android:gravity="center"
            android:text="按住 说话"
            android:textSize="15sp"
            android:textColor="@color/vak_text_secondary"
            android:visibility="gone" />

        <!-- 发送按钮 -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/vak_btn_send"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/vak_bg_circle_send"
            android:padding="7dp"
            app:srcCompat="@drawable/vak_ic_send"
            android:contentDescription="发送" />
    </LinearLayout>
</merge>
